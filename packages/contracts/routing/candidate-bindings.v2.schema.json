{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/candidate-bindings.v2",
  "title": "CandidateBindingsV2",
  "type": "array",
  "minItems": 1,
  "maxItems": 12,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
