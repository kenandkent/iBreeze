{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/backup-manifest.v1",
  "title": "BackupManifest",
  "type": "object",
  "properties": {
    "backup_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_directory_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sqlite_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "total_size": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "backup_id",
    "profile_directory_id",
    "created_at",
    "sqlite_sha256",
    "files",
    "total_size"
  ],
  "additionalProperties": false
}