{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.io/schemas/events/department.responsibility_changed.v1.schema.json",
  "title": "Department.responsibility Changed Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "company_id",
    "aggregate_id",
    "version",
    "responsibilities"
  ]
}
