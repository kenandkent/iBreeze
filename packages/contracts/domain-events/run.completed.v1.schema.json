{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.io/schemas/events/run.completed.v1.schema.json",
  "title": "Run.completed Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "from_state": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "started",
        "checkpointed",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "to_state": {
      "type": "string",
      "const": "succeeded"
    },
    "status": {
      "type": "string",
      "const": "succeeded"
    },
    "evidence_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "company_id",
    "aggregate_id",
    "version",
    "from_state",
    "to_state",
    "status",
    "evidence_artifact_ids"
  ]
}
