{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.io/schemas/events/report.generated.v1.schema.json",
  "title": "Report.generated Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "report_type": {
      "type": "string",
      "enum": [
        "department",
        "final"
      ]
    }
  },
  "required": [
    "company_id",
    "aggregate_id",
    "version",
    "report_type"
  ]
}
