{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.io/schemas/events/company_task.status_changed.v1.schema.json",
  "title": "Company Task.status Changed Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "from_state": {
      "type": "string",
      "enum": [
        "draft",
        "analyzing",
        "awaiting_user_confirmation",
        "approved",
        "revision_requested",
        "rejected",
        "dispatching",
        "checking_resources",
        "executing",
        "reviewing",
        "fixing",
        "final_review",
        "waiting_dependency",
        "waiting_resource",
        "waiting_permission",
        "paused",
        "cancelling",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "draft",
        "analyzing",
        "awaiting_user_confirmation",
        "approved",
        "revision_requested",
        "rejected",
        "dispatching",
        "checking_resources",
        "executing",
        "reviewing",
        "fixing",
        "final_review",
        "waiting_dependency",
        "waiting_resource",
        "waiting_permission",
        "paused",
        "cancelling",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  },
  "required": ["company_id", "aggregate_id", "version", "from_state", "to_state"]
}
