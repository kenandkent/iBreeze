{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.io/schemas/events/employee_task.status_changed.v1.schema.json",
  "title": "Employee Task.status Changed Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "from_state": {
      "type": "string",
      "enum": [
        "assigned",
        "ready",
        "running",
        "submitted",
        "peer_reviewing",
        "accepted",
        "changes_requested",
        "waiting_resource",
        "failed",
        "cancelled"
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "assigned",
        "ready",
        "running",
        "submitted",
        "peer_reviewing",
        "accepted",
        "changes_requested",
        "waiting_resource",
        "failed",
        "cancelled"
      ]
    }
  },
  "required": ["company_id", "aggregate_id", "version", "from_state", "to_state"]
}
