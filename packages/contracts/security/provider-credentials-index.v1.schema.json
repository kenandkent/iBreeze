{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/provider-credentials-index.v1",
  "title": "ProviderCredentialsIndexV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "credential_ref": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "normalized_label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "provider_release_id": { "type": "string", "format": "uuid" },
          "auth_type": { "enum": ["bearer", "x_api_key"] },
          "state": { "enum": ["creating", "updating", "unverified", "ready", "deleting"] },
          "resume_state": { "type": ["string", "null"], "enum": ["unverified", "ready", null] },
          "metadata_version": { "type": "integer", "minimum": 1 },
          "active_secret_version": { "type": ["integer", "null"], "minimum": 1 },
          "pending_secret_version": { "type": ["integer", "null"], "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["credential_ref", "label", "normalized_label", "provider_release_id", "auth_type", "state", "resume_state", "metadata_version", "active_secret_version", "pending_secret_version", "created_at", "updated_at"]
      }
    }
  },
  "required": ["schema_version", "revision", "credentials"]
}
