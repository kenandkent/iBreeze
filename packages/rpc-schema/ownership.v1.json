{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/rpc-ownership.v1",
  "title": "RPC Method Ownership",
  "description": "Ownership assignment for each local RPC method: rust_core, sidecar, or supervisor_only",
  "type": "object",
  "properties": {
    "rust_core": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sidecar": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "supervisor_only": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "required": ["rust_core", "sidecar", "supervisor_only"],
  "additionalProperties": false,
  "rust_core": [
    "backend.validateOrigin",
    "auth.register",
    "auth.login",
    "auth.changePassword",
    "auth.logout",
    "auth.listOfflineProfiles",
    "auth.openProfile",
    "auth.closeProfile"
  ],
  "sidecar": [
    "company.create",
    "company.get",
    "company.list",
    "company.update",
    "company.archive",
    "department.create",
    "department.get",
    "department.list",
    "department.update",
    "department.setLeader",
    "department.archive",
    "employee.create",
    "employee.get",
    "employee.list",
    "employee.updateBaseProfile",
    "employee.updateDisplayName",
    "employee.updateWorkRole",
    "employee.transfer",
    "employee.archive",
    "conversation.submitUserMessage",
    "task.get",
    "task.list",
    "task.confirmPlan",
    "task.cancel",
    "task.supersede",
    "departmentTask.get",
    "departmentTask.list",
    "employeeTask.get",
    "employeeTask.list",
    "artifact.get",
    "artifact.list",
    "artifact.create",
    "review.assign",
    "review.submit",
    "review.resolveIssue",
    "review.get",
    "review.list",
    "report.generateDepartment",
    "report.generateFinal",
    "run.get",
    "run.list",
    "knowledge.import",
    "knowledge.remove",
    "knowledge.get",
    "knowledge.list",
    "workspace.apply",
    "workspace.abandon",
    "workspace.cleanupTask",
    "workspace.get",
    "workspace.list",
    "backup.create",
    "backup.get",
    "backup.list",
    "backup.restore",
    "catalog.installSkill",
    "catalog.removeSkill",
    "catalog.get",
    "catalog.list",
    "profile.retireVersion",
    "profile.retire",
    "profile.get"
  ],
  "supervisor_only": [
    "system.handshake",
    "system.health",
    "system.shutdown"
  ]
}
