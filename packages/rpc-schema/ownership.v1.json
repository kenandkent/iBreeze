{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/rpc-ownership.v1",
  "title": "RPC Method Ownership",
  "description": "Ownership assignment for each local RPC method: rust_core, sidecar, or supervisor_only",
  "type": "object",
  "properties": {
    "rust_core": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sidecar": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "supervisor_only": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "required": ["rust_core", "sidecar", "supervisor_only"],
  "additionalProperties": false,
  "rust_core": [
    "auth.changePassword",
    "auth.closeProfile",
    "auth.listOfflineProfiles",
    "auth.login",
    "auth.logout",
    "auth.openProfile",
    "auth.register",
    "backend.validateOrigin"
  ],
  "sidecar": [
    "approval.listPending",
    "approval.resolve",
    "artifact.getSnapshot",
    "artifact.list",
    "backup.create",
    "backup.list",
    "backup.restore",
    "catalog.getActiveRelease",
    "catalog.installSkill",
    "catalog.listAgents",
    "catalog.listModels",
    "catalog.listSkills",
    "catalog.removeSkill",
    "catalog.sync",
    "catalog.verifyCache",
    "company.archive",
    "company.create",
    "company.get",
    "company.list",
    "company.update",
    "conversation.archive",
    "conversation.create",
    "conversation.getCompany",
    "conversation.getDepartment",
    "conversation.list",
    "conversation.listMessages",
    "conversation.submitUserMessage",
    "department.archive",
    "department.create",
    "department.get",
    "department.list",
    "department.responsibility.create",
    "department.responsibility.delete",
    "department.responsibility.update",
    "department.setLeader",
    "department.update",
    "departmentTask.checkResources",
    "departmentTask.getReport",
    "departmentTask.replaceEmployee",
    "employee.create",
    "employee.get",
    "employee.list",
    "employee.transfer",
    "employee.updateBaseProfile",
    "employee.updateDisplayName",
    "employee.updateStatus",
    "event.replay",
    "event.subscribe",
    "knowledge.import",
    "knowledge.list",
    "knowledge.remove",
    "knowledge.search",
    "profile.bindSkill",
    "profile.createDraft",
    "profile.get",
    "profile.list",
    "profile.publish",
    "profile.retire",
    "profile.retireVersion",
    "profile.unbindSkill",
    "profile.updateDraft",
    "profile.validate",
    "review.listIssues",
    "review.rerun",
    "review.resolveIssue",
    "review.submit",
    "run.cancel",
    "run.get",
    "run.list",
    "run.listEvents",
    "run.resume",
    "runtime.getStatus",
    "runtime.listAvailableModels",
    "runtime.probeAgent",
    "runtime.probeProvider",
    "runtime.run",
    "runtime.stop",
    "settings.get",
    "settings.update",
    "task.cancel",
    "task.confirmPlan",
    "task.get",
    "task.getEvidence",
    "task.getGraph",
    "task.list",
    "task.pause",
    "task.rejectPlan",
    "task.requestPlanRevision",
    "task.resume",
    "workspace.abandon",
    "workspace.apply",
    "workspace.cleanupTask",
    "workspace.get",
    "workspace.list"
  ],
  "supervisor_only": [
    "system.handshake",
    "system.health",
    "system.shutdown"
  ]
}
