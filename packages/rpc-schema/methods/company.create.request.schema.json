{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/company.create.request.v1",
  "title": "CompanyCreateRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "introduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "general_manager_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "base_profile_version_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "name",
    "introduction",
    "general_manager_name",
    "base_profile_version_id"
  ],
  "additionalProperties": false
}
