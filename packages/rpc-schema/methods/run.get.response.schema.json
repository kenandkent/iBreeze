{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/run.get.response.v1",
  "title": "RunGetResponse",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "started",
        "checkpointed",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "run_id",
    "status",
    "agent_id",
    "progress",
    "created_at",
    "updated_at"
  ]
}
