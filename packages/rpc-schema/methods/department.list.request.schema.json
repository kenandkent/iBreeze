{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/department.list.request.v1",
  "title": "DepartmentListRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "filter": {
      "type": "object",
      "additionalProperties": true
    },
    "cursor": {
      "type": ["string", "null"]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "required": [
    "company_id"
  ]
}
