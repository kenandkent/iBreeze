{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/catalog.installSkill.request.v1",
  "title": "CatalogInstallskillRequest",
  "type": "object",
  "properties": {
    "skill_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "skill_id": {
      "type": "string",
      "format": "uuid"
    },
    "skill_version": {
      "type": "string"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_path": {
      "type": "string"
    },
    "catalog_release_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "required": [
    "skill_version_id",
    "skill_id",
    "skill_version",
    "package_sha256"
  ]
}
