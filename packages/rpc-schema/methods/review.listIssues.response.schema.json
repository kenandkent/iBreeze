{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/review.listIssues.response.v1",
  "title": "ReviewListissuesResponse",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "format": "uuid"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "high",
              "medium",
              "low"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "fixing",
              "resolved",
              "verified",
              "closed",
              "rejected"
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "verifier_employee_id": {
            "oneOf": [
              {"type": "string", "format": "uuid"},
              {"type": "null"}
            ]
          },
          "rejection_reason": {
            "oneOf": [
              {"type": "string", "maxLength": 2000},
              {"type": "null"}
            ]
          }
        },
        "required": [
          "issue_id",
          "severity",
          "state",
          "category",
          "description",
          "verifier_employee_id",
          "rejection_reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "issues"
  ]
}
