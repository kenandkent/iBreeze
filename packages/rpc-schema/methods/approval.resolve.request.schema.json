{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/approval.resolve.request.v1",
  "title": "ApprovalResolveRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "approval_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "company_id",
    "approval_id",
    "decision"
  ]
}
