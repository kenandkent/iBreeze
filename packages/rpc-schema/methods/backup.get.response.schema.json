{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/backup.get.response.v1",
  "title": "BackupGetResponse",
  "type": "object",
  "properties": {
    "backup_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "verified",
        "restored"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "backup_id",
    "version",
    "status",
    "created_at"
  ]
}
