{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/company.list.request.v1",
  "title": "CompanyListRequest",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
