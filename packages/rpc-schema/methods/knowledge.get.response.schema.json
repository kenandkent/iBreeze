{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/knowledge.get.response.v1",
  "title": "KnowledgeGetResponse",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "item_id",
    "content",
    "content_hash",
    "version",
    "created_at",
    "updated_at"
  ]
}
