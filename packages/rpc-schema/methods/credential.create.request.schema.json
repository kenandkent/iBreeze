{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/credential.create.request.v1",
  "title": "CredentialCreateRequest",
  "type": "object", "additionalProperties": false,
  "properties": {
    "label": {"type":"string","minLength":1,"maxLength":100},
    "provider_release_id": {"type":"string","format":"uuid"},
    "auth_type": {"enum":["bearer","x_api_key"]},
    "secret": {"type":"string","minLength":1,"maxLength":16384}
  },
  "required":["label","provider_release_id","auth_type","secret"]
}
