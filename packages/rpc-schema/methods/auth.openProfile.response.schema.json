{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/auth.openProfile.response.v1",
  "title": "AuthOpenProfileResponse",
  "type": "object",
  "properties": {
    "profile_directory_id": {
      "type": "string"
    },
