{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/profile.createDraft.request.v1",
  "title": "ProfileCreatedraftRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "employee_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_cli": {
      "type": "string"
    },
    "api_model": {
      "type": "string"
    },
    "credential_ref": {
      "type": "string",
      "format": "uuid"
    },
    "provider_release_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_binding_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider_protocol": {
      "enum": ["openai_responses", "anthropic_messages", "openai_chat_completions"]
    },
    "base_profile": {
      "type": "object"
    },
    "routing_policy": {
      "$ref": "https://ibreeze.ai/schemas/routing-policy-rpc.v1"
    }
  },
  "additionalProperties": false,
  "required": [
    "company_id",
    "employee_id"
  ]
}
