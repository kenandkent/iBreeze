{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/profile.get.response.v1",
  "title": "ProfileGetResponse",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "profile_id",
    "display_name",
    "status",
    "version",
    "created_at",
    "updated_at"
  ]
}
