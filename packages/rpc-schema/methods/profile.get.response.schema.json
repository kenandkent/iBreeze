{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/profile.get.response.v1",
  "title": "ProfileGetResponse",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_type": {
      "enum": ["agent_cli", "api_model"]
    },
    "current_version_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "routing_policy_json": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["draft", "published", "retired"] },
          "profile_type": { "enum": ["agent_cli", "api_model"] },
          "routing_policy_json": { "type": "string" }
        },
        "required": ["id", "status", "profile_type", "routing_policy_json"]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "profile_id",
    "display_name",
    "status",
    "version",
    "created_at",
    "updated_at",
    "profile_type",
    "current_version_id",
    "routing_policy_json",
    "versions"
  ]
}
