{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/auth.login.response.v1",
  "title": "AuthLoginResponse",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "password_change_required",
        "profile_opened"
      ]
    },
    "profile_directory_id": {
      "type": "string"
    },
    "masked_identifier": {
      "type": "string"
    },
    "catalog_release_sequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "status",
    "profile_directory_id",
    "masked_identifier",
    "catalog_release_sequence"
  ],
  "additionalProperties": false
}