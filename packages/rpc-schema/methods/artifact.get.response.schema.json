{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/artifact.get.response.v1",
  "title": "ArtifactGetResponse",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "verified"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "version",
    "sha256",
    "status",
    "created_at"
  ]
}
