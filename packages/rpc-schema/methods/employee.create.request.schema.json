{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibreeze.ai/schemas/employee.create.request.v1",
  "title": "EmployeeCreateRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "department_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "base_profile_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_role": {
      "type": "string",
      "enum": ["department_leader", "member", "reviewer"]
    }
  },
  "additionalProperties": false,
  "required": [
    "company_id",
    "department_id",
    "display_name",
    "base_profile_version_id",
    "workflow_role"
  ]
}
